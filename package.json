{
  "name": "flowos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "FLOWOS — the AI operating system for business operations",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --env-file-if-exists=.env server/src/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server/index.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env server/src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/src/db/seed.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "test:e2e": "node e2e/smoke.mjs",
    "e2e:ai-harness": "npm run build:client && NODE_ENV=production APP_ORIGIN=http://localhost:3200 tsx --env-file-if-exists=.env e2e/ai-harness.ts",
    "test:e2e:assistant": "E2E_BASE_URL=http://localhost:3200 node e2e/assistant.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@tanstack/react-query": "^5.104.1",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^1.54.0",
    "pg": "^8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.4",
    "superjson": "^2.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  }
}
