# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://flowos:flowos@localhost:5432/flowos
# Public origin the browser uses; mutations from other origins are rejected.
APP_ORIGIN=http://localhost:5173
# Number of reverse-proxy hops in front of the app (load balancer = 1). Required for correct
# client IPs in rate limits and audit logs; 0 means clients connect directly.
TRUST_PROXY=0
# Private document storage directory (persistent, backed up, never web-served).
STORAGE_DIR=./storage
# Apply pending migrations at boot (single-instance only). Default: run `npm run db:migrate`.
FLOWOS_MIGRATE_ON_START=false
# Run the workflow worker in this process. Set false on API-only replicas.
FLOWOS_WORKER=true
# Optional. When unset the AI assistant reports itself as not configured.
# Put the real key only in your untracked .env or your host's secret store, never in this file.
ANTHROPIC_API_KEY=
# Optional. 32 random bytes, base64 (openssl rand -base64 32). Required to connect Slack/Teams.
INTEGRATIONS_ENCRYPTION_KEY=
# Optional. Billing is enabled only when all of these are set; otherwise no plan limits apply.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=
